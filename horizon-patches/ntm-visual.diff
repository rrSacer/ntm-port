@@ -0,0 +1,429 @@
+//! Machines from content mods: blocks with slots the game keeps, a screen
+//! layout and, optionally, a multiblock volume. Each
+//! `data/<namespace>/horizon_machine/<name>.json` in the resource root
+//! describes the block `<namespace>:<name>`. The folder is outside
+//! `data/<id>/horizon/`, so a game without machines ignores it and the mod
+//! stays valid there.
+//!
+//! ```text
+//! {
+//!   "title": "container.ntm.assembler",   translation key (else the block's name)
+//!   "screen": "ntm:assembler",            assets/ntm/horizon_screen/assembler.json (default: the block's id)
+//!   "slots": [                            in slot order; positions as the screen draws them
+//!     {"x": 152, "y": 81, "accept": ["ntm:battery_generic"]},
+//!     {"grid": [8, 18, 4, 3]},            x, y, columns, rows: one input slot each
+//!     {"x": 8, "y": 90, "reject": ["ntm:blades_steel"]},   anything but these
+//!     {"x": 98, "y": 45, "output": true}  the player takes from it, never puts into it
+//!     {"x": 26, "y": 36, "accept": ["ntm:explosive_lenses"], "max": 1}   at most 1 item
+//!   ],
+//!   "inventory": [8, 174],                the player's inventory (hotbar 58 below)
+//!   "data": 4,                            values the mod sets and the screen shows
+//!   "synced": [0, 1, 2],                  those clients get (a model's liquids)
+//!   "multiblock": {                       the volume around the core, in the placer's frame:
+//!     "min": [-1, 0, -1], "max": [1, 2, 1], x to the right, y up, z away from the player
+//!     "offset": 1,                        the core sits this far away from the clicked cell
+//!     "dummy": "ntm:dummy_block"          the block every other cell holds
+//!   }
+//! }
+//! ```
+use serde_json::Value;
+use std::{
+    collections::HashMap,
+    fs,
+    path::Path,
+    sync::{Arc, RwLock},
+};
+
+/// What a slot takes.
+#[derive(Clone, Debug, PartialEq)]
+pub enum SlotRule {
+    Any,
+    /// Only these item ids.
+    Only(Vec<String>),
+    /// Anything but these item ids.
+    Except(Vec<String>),
+    /// Nothing: the player takes from it.
+    Output,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct SlotDef {
+    pub x: i32,
+    pub y: i32,
+    pub rule: SlotRule,
+    /// The most items it holds (`Slot.getMaxStackSize`): a bomb's part slot
+    /// holds one. None: the item's own stack size.
+    pub max: Option<u32>,
+}
+
+impl SlotDef {
+    pub fn accepts(&self, item: &str) -> bool {
+        match &self.rule {
+            SlotRule::Any => true,
+            SlotRule::Only(items) => items.iter().any(|i| i == item),
+            SlotRule::Except(items) => !items.iter().any(|i| i == item),
+            SlotRule::Output => false,
+        }
+    }
+}
+
+/// The cells of a multiblock around its core, in the placer's frame.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Multiblock {
+    pub min: [i32; 3],
+    pub max: [i32; 3],
+    pub offset: i32,
+    pub dummy: String,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct MachineDef {
+    /// The block, `<namespace>:<name>`.
+    pub block: String,
+    /// Its place in [`all`]: the menu kind's number.
+    pub index: u16,
+    pub title: Option<String>,
+    pub screen: String,
+    pub slots: Vec<SlotDef>,
+    pub inventory: [i32; 2],
+    pub data: usize,
+    /// The values clients get (a model's liquid levels and colours).
+    pub synced: Vec<usize>,
+    pub multiblock: Option<Multiblock>,
+}
+
+/// Most slots and data values one machine may declare.
+pub const MAX_SLOTS: usize = 128;
+pub const MAX_DATA: usize = 256;
+
+#[derive(Default)]
+struct Registry {
+    list: Vec<Arc<MachineDef>>,
+    by_block: HashMap<String, usize>,
+    dummies: HashMap<String, ()>,
+    /// The largest distance from a core to one of its cells, on any axis.
+    reach: i32,
+}
+
+static REGISTRY: RwLock<Option<Arc<Registry>>> = RwLock::new(None);
+
+fn registry() -> Option<Arc<Registry>> {
+    REGISTRY.read().ok().and_then(|r| r.clone())
+}
+
+fn ints<const N: usize>(v: &Value) -> Option<[i32; N]> {
+    let a = v.as_array().filter(|a| a.len() == N)?;
+    let mut out = [0; N];
+    for (o, x) in out.iter_mut().zip(a) {
+        *o = i32::try_from(x.as_i64()?).ok()?;
+    }
+    Some(out)
+}
+
+/// Reads one machine file; the error says what is wrong in it.
+pub fn parse(block: &str, doc: &Value) -> Result<MachineDef, String> {
+    let mut slots = Vec::new();
+    for s in doc["slots"].as_array().ok_or("no slots")? {
+        let rule = if s["output"].as_bool() == Some(true) {
+            SlotRule::Output
+        } else if let Some(items) = s["accept"].as_array() {
+            SlotRule::Only(
+                items
+                    .iter()
+                    .filter_map(|i| i.as_str().map(str::to_owned))
+                    .collect(),
+            )
+        } else if let Some(items) = s["reject"].as_array() {
+            SlotRule::Except(
+                items
+                    .iter()
+                    .filter_map(|i| i.as_str().map(str::to_owned))
+                    .collect(),
+            )
+        } else {
+            SlotRule::Any
+        };
+        let max = s["max"].as_u64().map(|m| m.clamp(1, 99) as u32);
+        if let Some([x, y, columns, rows]) = ints::<4>(&s["grid"]) {
+            for r in 0..rows.max(0) {
+                for c in 0..columns.max(0) {
+                    slots.push(SlotDef {
+                        x: x + c * 18,
+                        y: y + r * 18,
+                        rule: rule.clone(),
+                        max,
+                    });
+                }
+            }
+        } else {
+            let (Some(x), Some(y)) = (s["x"].as_i64(), s["y"].as_i64()) else {
+                return Err("a slot without x and y (or grid)".into());
+            };
+            slots.push(SlotDef {
+                x: x as i32,
+                y: y as i32,
+                rule,
+                max,
+            });
+        }
+    }
+    if slots.len() > MAX_SLOTS {
+        return Err(format!("{} slots (at most {MAX_SLOTS})", slots.len()));
+    }
+    let data = doc["data"].as_u64().unwrap_or(0) as usize;
+    if data > MAX_DATA {
+        return Err(format!("{data} data values (at most {MAX_DATA})"));
+    }
+    let multiblock = match doc.get("multiblock") {
+        None | Some(Value::Null) => None,
+        Some(m) => {
+            let min = ints::<3>(&m["min"]).ok_or("multiblock: no min [x, y, z]")?;
+            let max = ints::<3>(&m["max"]).ok_or("multiblock: no max [x, y, z]")?;
+            if (0..3).any(|i| min[i] > 0 || max[i] < 0 || max[i] - min[i] > 15) {
+                return Err("multiblock: min..max must hold the core and span 16 at most".into());
+            }
+            Some(Multiblock {
+                min,
+                max,
+                offset: m["offset"].as_i64().unwrap_or(0) as i32,
+                dummy: m["dummy"]
+                    .as_str()
+                    .ok_or("multiblock: no dummy block")?
+                    .to_owned(),
+            })
+        }
+    };
+    Ok(MachineDef {
+        block: block.to_owned(),
+        index: 0,
+        title: doc["title"].as_str().map(str::to_owned),
+        screen: doc["screen"].as_str().unwrap_or(block).to_owned(),
+        slots,
+        inventory: ints::<2>(&doc["inventory"]).unwrap_or([8, 84]),
+        data,
+        synced: doc["synced"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|v| v.as_u64().map(|i| i as usize))
+            .filter(|&i| i < data)
+            .collect(),
+        multiblock,
+    })
+}
+
+/// The machine files under `root`, as (block id, file).
+pub fn files(root: &Path) -> Vec<(String, std::path::PathBuf)> {
+    let mut out = Vec::new();
+    let Ok(namespaces) = fs::read_dir(root.join("data")) else {
+        return out;
+    };
+    for ns in namespaces.flatten() {
+        let Some(namespace) = ns.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if namespace == "minecraft" {
+            continue;
+        }
+        let Ok(entries) = fs::read_dir(ns.path().join("horizon_machine")) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.extension().and_then(|e| e.to_str()) != Some("json") {
+                continue;
+            }
+            if let Some(name) = path.file_stem().and_then(|s| s.to_str()) {
+                out.push((format!("{namespace}:{name}"), path.clone()));
+            }
+        }
+    }
+    out.sort();
+    out
+}
+
+/// Loads the machines of `root`, replacing those loaded before: how many,
+/// and what was wrong in the files left out.
+pub fn load(root: &Path) -> (usize, Vec<String>) {
+    let mut reg = Registry::default();
+    let mut warnings = Vec::new();
+    for (block, path) in files(root) {
+        let doc = fs::read(&path)
+            .map_err(|e| e.to_string())
+            .and_then(|b| serde_json::from_slice::<Value>(&b).map_err(|e| e.to_string()))
+            .and_then(|doc| parse(&block, &doc));
+        match doc {
+            Ok(mut def) => {
+                def.index = reg.list.len() as u16;
+                if let Some(m) = &def.multiblock {
+                    reg.dummies.insert(m.dummy.clone(), ());
+                    let reach = (0..3)
+                        .map(|i| m.min[i].abs().max(m.max[i].abs()))
+                        .max()
+                        .unwrap_or(0);
+                    reg.reach = reg.reach.max(reach);
+                }
+                reg.by_block.insert(block, reg.list.len());
+                reg.list.push(Arc::new(def));
+            }
+            Err(e) => warnings.push(format!("{}: {e}", path.display())),
+        }
+    }
+    let n = reg.list.len();
+    if let Ok(mut r) = REGISTRY.write() {
+        *r = (n > 0).then(|| Arc::new(reg));
+    }
+    (n, warnings)
+}
+
+/// The machine of block `name`.
+pub fn get(name: &str) -> Option<Arc<MachineDef>> {
+    let r = registry()?;
+    r.by_block.get(name).map(|&i| r.list[i].clone())
+}
+
+/// The machine with menu number `index`.
+pub fn by_index(index: u16) -> Option<Arc<MachineDef>> {
+    registry()?.list.get(index as usize).cloned()
+}
+
+/// Every machine, in menu order.
+pub fn all() -> Vec<Arc<MachineDef>> {
+    registry().map_or_else(Vec::new, |r| r.list.clone())
+}
+
+/// Whether `name` is the filler block of some multiblock.
+pub fn is_dummy(name: &str) -> bool {
+    registry().is_some_and(|r| r.dummies.contains_key(name))
+}
+
+/// How far from a cell its core may be, on any axis (0 with no multiblocks).
+pub fn reach() -> i32 {
+    registry().map_or(0, |r| r.reach)
+}
+
+/// The horizontal step of a `facing` value: the way the block's front looks.
+pub fn facing_step(facing: &str) -> Option<[i32; 2]> {
+    Some(match facing {
+        "north" => [0, -1],
+        "south" => [0, 1],
+        "west" => [-1, 0],
+        "east" => [1, 0],
+        _ => return None,
+    })
+}
+
+impl Multiblock {
+    /// The world cell of local cell `l` of a core at `core` whose front looks
+    /// `facing` (the placer looked the other way: z runs away from them).
+    pub fn cell(&self, core: [i32; 3], facing: [i32; 2], l: [i32; 3]) -> [i32; 3] {
+        let forward = [-facing[0], -facing[1]];
+        let right = [-forward[1], forward[0]];
+        [
+            core[0] + right[0] * l[0] + forward[0] * l[2],
+            core[1] + l[1],
+            core[2] + right[1] * l[0] + forward[1] * l[2],
+        ]
+    }
+    /// Every cell but the core's.
+    pub fn cells(&self, core: [i32; 3], facing: [i32; 2]) -> Vec<[i32; 3]> {
+        let mut out = Vec::new();
+        for y in self.min[1]..=self.max[1] {
+            for z in self.min[2]..=self.max[2] {
+                for x in self.min[0]..=self.max[0] {
+                    if [x, y, z] != [0, 0, 0] {
+                        out.push(self.cell(core, facing, [x, y, z]));
+                    }
+                }
+            }
+        }
+        out
+    }
+    /// Where the core goes when the item is used on cell `placed`.
+    pub fn core_for(&self, placed: [i32; 3], facing: [i32; 2]) -> [i32; 3] {
+        self.cell(placed, facing, [0, 0, self.offset])
+    }
+    /// The volume's box in world coordinates (min corner, max corner + 1).
+    pub fn bounds(&self, core: [i32; 3], facing: [i32; 2]) -> ([i32; 3], [i32; 3]) {
+        let a = self.cell(core, facing, self.min);
+        let b = self.cell(core, facing, self.max);
+        let lo = [a[0].min(b[0]), a[1].min(b[1]), a[2].min(b[2])];
+        let hi = [a[0].max(b[0]) + 1, a[1].max(b[1]) + 1, a[2].max(b[2]) + 1];
+        (lo, hi)
+    }
+}
+
+/// The core of the multiblock that holds cell `pos`: `block_at` gives a
+/// cell's block id and `facing` value. None when no core around claims it.
+pub fn core_of(
+    pos: [i32; 3],
+    mut block_at: impl FnMut([i32; 3]) -> (String, Option<String>),
+) -> Option<[i32; 3]> {
+    let reach = reach();
+    if reach == 0 {
+        return None;
+    }
+    for dy in -reach..=reach {
+        for dz in -reach..=reach {
+            for dx in -reach..=reach {
+                let c = [pos[0] + dx, pos[1] + dy, pos[2] + dz];
+                let (name, facing) = block_at(c);
+                let Some(def) = get(&name) else { continue };
+                let (Some(m), Some(f)) = (&def.multiblock, facing.as_deref().and_then(facing_step))
+                else {
+                    continue;
+                };
+                let (lo, hi) = m.bounds(c, f);
+                if (0..3).all(|i| pos[i] >= lo[i] && pos[i] < hi[i]) {
+                    return Some(c);
+                }
+            }
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_footprint_turns_with_the_facing() {
+        let m = Multiblock {
+            min: [-1, 0, 0],
+            max: [1, 1, 2],
+            offset: 1,
+            dummy: "x:d".into(),
+        };
+        // Facing north: the placer looked south (+z), their right is west.
+        let f = facing_step("north").unwrap();
+        assert_eq!(m.core_for([0, 64, 0], f), [0, 64, 1]);
+        assert_eq!(m.cell([0, 64, 0], f, [1, 0, 2]), [-1, 64, 2]);
+        let (lo, hi) = m.bounds([0, 64, 0], f);
+        assert_eq!((lo, hi), ([-1, 64, 0], [2, 66, 3]));
+        assert_eq!(m.cells([0, 64, 0], f).len(), 3 * 2 * 3 - 1);
+        // Facing east: the placer looked west (-x), their right is north.
+        let f = facing_step("east").unwrap();
+        assert_eq!(m.cell([0, 64, 0], f, [1, 0, 2]), [-2, 64, -1]);
+    }
+
+    #[test]
+    fn grids_expand_and_rules_read() {
+        let doc: Value = serde_json::from_str(
+            r#"{"slots":[{"x":1,"y":2,"accept":["a:b"],"max":1},{"grid":[8,18,4,3]},{"x":9,"y":9,"output":true},{"x":0,"y":0,"reject":["a:b"]}],
+                "data":3,"synced":[2,0,7],"multiblock":{"min":[-1,0,-1],"max":[1,2,1],"offset":1,"dummy":"a:d"}}"#,
+        )
+        .unwrap();
+        let def = parse("a:m", &doc).unwrap();
+        assert_eq!(def.slots.len(), 15);
+        assert!(!def.slots[14].accepts("a:b") && def.slots[14].accepts("a:c"));
+        assert_eq!((def.slots[4].x, def.slots[4].y), (8 + 18 * 3, 18));
+        assert!(def.slots[0].accepts("a:b") && !def.slots[0].accepts("a:c"));
+        assert_eq!((def.slots[0].max, def.slots[1].max), (Some(1), None));
+        assert!(!def.slots[13].accepts("a:b"));
+        assert_eq!(def.screen, "a:m");
+        // A synced index past the values is dropped.
+        assert_eq!(def.synced, [2, 0]);
+        assert_eq!(def.multiblock.unwrap().offset, 1);
+    }
+}
