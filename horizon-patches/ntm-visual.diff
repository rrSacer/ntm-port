diff --git a/crates/horizon-client/src/game/mod_machines.rs b/crates/horizon-client/src/game/mod_machines.rs
new file mode 100644
index 000000000..64e555ed0
--- /dev/null
+++ b/crates/horizon-client/src/game/mod_machines.rs
@@ -0,0 +1,361 @@
+//! Content mods' machines in the game (`horizon_world::mod_machines`): a
+//! multiblock breaks as one block, whichever of its cells the player mines.
+use super::Game;
+use horizon_core::position::BlockPos;
+
+impl Game<'_> {
+    /// The multiblock that holds `pos`: its core and its other cells.
+    pub(super) fn machine_multiblock(
+        &mut self,
+        pos: [i32; 3],
+    ) -> Option<([i32; 3], Vec<[i32; 3]>)> {
+        let at = BlockPos::new(pos[0], pos[1], pos[2]);
+        let core = self.with_level(|b, level, _| b.machine_core(&*level, at))?;
+        let state = self.world.block(core.x, core.y, core.z);
+        let name = self.res.facts().get(state).name.clone();
+        let def = horizon_world::mod_machines::get(&name)?;
+        let m = def.multiblock.as_ref()?;
+        let facing = self
+            .pack
+            .assets
+            .registry
+            .state(state)
+            .and_then(|s| s.properties.get("facing"))
+            .and_then(|f| horizon_world::mod_machines::facing_step(f))
+            .unwrap_or([0, 1]);
+        let core = [core.x, core.y, core.z];
+        Some((core, m.cells(core, facing)))
+    }
+
+    /// Takes away the filler cells of a broken multiblock: no drops (the
+    /// core dropped the machine), shape updates as any removal.
+    pub(super) fn clear_multiblock(&mut self, cells: &[[i32; 3]]) {
+        let air = self.world.air;
+        for &c in cells {
+            let state = self.world.block(c[0], c[1], c[2]);
+            if !horizon_world::mod_machines::is_dummy(&self.res.facts().get(state).name) {
+                continue;
+            }
+            let at = BlockPos::new(c[0], c[1], c[2]);
+            self.with_level(|b, level, ticks| b.set_block(level, ticks, at, air, 3));
+        }
+    }
+}
+
+use horizon_client::{
+    containers::BlockEntity,
+    hud::{HudBatch, rgba},
+    mod_screens::ScreenDef,
+};
+use horizon_world::mod_machines::MachineDef;
+use std::sync::Arc;
+use winit::keyboard::KeyCode;
+
+impl Game<'_> {
+    /// The open container's machine and screen, when it is a mod machine.
+    pub(super) fn open_machine(&self) -> Option<(Arc<MachineDef>, Option<Arc<ScreenDef>>)> {
+        let Some(BlockEntity::ModContainer(m)) = self.container_kind() else {
+            return None;
+        };
+        let def = horizon_world::mod_machines::get(&m.block)?;
+        let screen = horizon_client::mod_screens::get(&def.screen);
+        Some((def, screen))
+    }
+
+    /// The open machine screen's size (176 x 166 without a screen file).
+    pub(super) fn machine_screen_size(&self) -> Option<[f32; 2]> {
+        let (def, screen) = self.open_machine()?;
+        Some(screen.map_or_else(|| [176.0, def.inventory[1] as f32 + 82.0], |s| s.size))
+    }
+
+    /// Where the open machine screen puts slot `i`: the machine file's slots
+    /// (300 and up), the inventory where the file says.
+    pub(super) fn mod_slot_position(&self, i: usize) -> Option<(f32, f32)> {
+        let (def, _) = self.open_machine()?;
+        let [ix, iy] = def.inventory.map(|v| v as f32);
+        Some(match i {
+            0..9 => (ix + i as f32 * 18.0, iy + 58.0),
+            9..36 => (
+                ix + ((i - 9) % 9) as f32 * 18.0,
+                iy + ((i - 9) / 9) as f32 * 18.0,
+            ),
+            300..500 => {
+                let s = def.slots.get(i - 300)?;
+                (s.x as f32, s.y as f32)
+            }
+            _ => return None,
+        })
+    }
+
+    /// The open machine's background, bars, lights and labels; a plain
+    /// panel with slot frames when its screen or texture is missing.
+    pub(super) fn draw_mod_machine(&self, batch: &mut HudBatch, ox: f32, oy: f32) {
+        let Some((def, screen)) = self.open_machine() else {
+            return;
+        };
+        let Some(BlockEntity::ModContainer(m)) = self.container_kind() else {
+            return;
+        };
+        let atlas = &self.gui.atlas;
+        let grey = rgba(64, 64, 64, 255);
+        let screen = screen.filter(|s| s.ready(atlas));
+        let [w, h] = self.machine_screen_size().unwrap_or([176.0, 166.0]);
+        match &screen {
+            Some(s) => {
+                s.draw(batch, atlas, ox, oy, &m.data, |slot| {
+                    m.items.get(slot).is_some_and(Option::is_some)
+                });
+                // Its buttons for the control socket (`horizon-ctl
+                // click-button`), by their tooltip's first line.
+                for b in &s.buttons {
+                    if let Some(label) = b.lines.first() {
+                        let [x, y, w, h] = b.rect;
+                        horizon_client::widgets::record(label, [ox + x, oy + y, w, h], true);
+                    }
+                }
+            }
+            None => {
