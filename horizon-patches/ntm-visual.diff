+// Content mods' block models (gfx::mod_models): a bone's retained mesh in its
+// own frame, placed by the instance's matrix (attributes 7 to 10) and lit by
+// its light (11); the normal turns with it.
+@vertex fn vs_model(@location(0) position: vec3<f32>, @location(1) uv: vec2<f32>,
+    @location(2) overlay: u32, @location(3) color: vec4<f32>, @location(4) light: vec4<u32>, @location(5) normal: vec4<f32>,
+    @location(7) m0: vec4<f32>, @location(8) m1: vec4<f32>, @location(9) m2: vec4<f32>, @location(10) m3: vec4<f32>,
+    @location(11) instance_light: vec4<u32>) -> Out {
+    let m = mat4x4<f32>(m0, m1, m2, m3);
+    let p = (m * vec4(position, 1.0)).xyz;
+    let n = vec4(normalize((m * vec4(normal.xyz, 0.0)).xyz), normal.w);
+    return entity_vertex(p, uv, overlay, color, instance_light, n);
+}
