+//! Screens of content mods' machines (`horizon_world::mod_machines`): the
+//! machine's own background texture, with bars, lights and tooltips drawn
+//! from the values the mod sets. Each `assets/<namespace>/horizon_screen/<name>.json`
+//! of the resource root is the screen `<namespace>:<name>`; slots are the
+//! machine file's.
+//!
+//! ```text
+//! {
+//!   "texture": "ntm:textures/gui/processing/gui_assembler.png",
+//!   "size": [176, 256],                      the screen, drawn from the texture's top left
+//!   "title": [70, 6, "center"],              x, y, alignment ("left" or "center")
+//!   "title_color": "#ffffff",                the title's colour (vanilla's grey without it)
+//!   "inventory_label": [8, 162],             null: none
+//!   "bars": [                                value `value` of `max` (a value's index, or "max_value")
+//!     {"value": 0, "max": 1, "rect": [152, 18, 16, 61], "uv": [176, 0], "dir": "up"},
+//!     {"value": 4, "max_value": 4000, "rect": [8, 99, 52, 16], "color": 6, "dir": "right"},
+//!     {"value": 2, "from": 248, "max_value": 497, "rect": [92, 21, 12, 36], "uv": [182, 37], "dir": "up"}
+//!                                            `from`: empty up to that value (one of HBM's
+//!                                            centrifuge's four progress columns)
+//!   ],                                       `color`: a value's index holding 0xRRGGBB, in place of uv
+//!   "overlays": [                            a part of the texture drawn while ...
+//!     {"slot": 0, "rect": [142, 90, 16, 16], "uv": [176, 0]},    ... the slot holds something
+//!     {"value": 7, "min": 1, "rect": [51, 121, 6, 8], "uv": [195, 0]}  ... a value is in min..=max (max: none)
+//!   ],
+//!   "gauges": [                              HBM's drawSmoothGauge: a needle from 0 (lower left)
+//!     {"value": 2, "max": 3, "at": [34, 25], "tip": 5, "back": 2, "side": 1, "color": "#7f0000"}
+//!   ],                                       round 270 degrees to the value's share of `max`
+//!   "tooltips": [{"rect": [152, 18, 16, 61], "lines": ["{0:si} / {1:si} HE"]}],
+//!   "buttons": [{"id": 0, "rect": [7, 125, 18, 18], "lines": ["Choose a recipe"]}]
+//! }                                          a button's "shift": the id sent while shift is held
+//!                                            (HBM's shift-click: the anvil crafts all it can)
+//! ```
+use crate::hud::{HudAtlas, HudBatch, Rect};
+use serde_json::Value;
+use std::{
+    collections::HashMap,
+    fs,
+    path::{Path, PathBuf},
+    sync::{Arc, RwLock},
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Dir {
+    Up,
+    Down,
+    Left,
+    Right,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Max {
+    Value(usize),
+    Fixed(i32),
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Bar {
+    pub value: usize,
+    /// The value at which it starts to fill.
+    pub from: i32,
+    pub max: Max,
+    pub rect: [f32; 4],
+    pub uv: Option<[f32; 2]>,
+    pub color: Option<usize>,
+    pub dir: Dir,
+}
+
+/// HBM's `GUIElements.drawSmoothGauge`: a needle turning round its centre.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Gauge {
+    pub value: usize,
+    pub max: Max,
+    pub at: [f32; 2],
+    /// The needle's length forward, back, and its half width at the back.
+    pub tip: f32,
+    pub back: f32,
+    pub side: f32,
+    /// 0xRRGGBB.
+    pub color: u32,
+}
+
+/// The needle's three corners from its centre at `progress` (0..=1), as
+/// drawSmoothGauge turns them (`Vec3.rotateAroundZ`, GUI y down), scaled
+/// by `mult` (1.5 for its black outline).
+pub fn needle(progress: f32, tip: f32, back: f32, side: f32, mult: f32) -> [[f32; 2]; 3] {
+    let a = (-progress.clamp(0.0, 1.0) * 270.0 - 45.0).to_radians();
+    let (sin, cos) = a.sin_cos();
+    let turn = |[x, y]: [f32; 2]| [(x * cos + y * sin) * mult, (y * cos - x * sin) * mult];
+    [turn([0.0, tip]), turn([side, -back]), turn([-side, -back])]
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum When {
+    Slot(usize),
+    Value { index: usize, min: i32, max: i32 },
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Overlay {
+    pub when: When,
+    pub rect: [f32; 4],
+    pub uv: [f32; 2],
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Tip {
+    pub rect: [f32; 4],
+    pub lines: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Button {
+    pub id: u32,
+    /// The id sent while shift is held, when not `id`.
+    pub shift: Option<u32>,
+    pub rect: [f32; 4],
+    pub lines: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ScreenDef {
+    /// The texture's sprite in the GUI atlas: `ntm:gui/processing/gui_assembler`.
+    pub sprite: String,
+    /// Its file, loaded into a GUI slot of the atlas when the screen opens.
+    pub file: PathBuf,
+    pub size: [f32; 2],
+    pub title: Option<([f32; 2], bool)>,
+    /// The title's colour as 0xRRGGBB, when not vanilla's grey.
+    pub title_color: Option<u32>,
+    pub inventory_label: Option<[f32; 2]>,
+    pub bars: Vec<Bar>,
+    pub gauges: Vec<Gauge>,
+    pub overlays: Vec<Overlay>,
+    pub tips: Vec<Tip>,
+    pub buttons: Vec<Button>,
+}
+
+static SCREENS: RwLock<Option<Arc<HashMap<String, Arc<ScreenDef>>>>> = RwLock::new(None);
+
+/// A texture reference (`ntm:textures/gui/x.png`) as the atlas names it
+/// (`ntm:gui/x`), and its file under `root`.
+pub fn texture_sprite(root: &Path, reference: &str) -> Option<(String, PathBuf)> {
+    let (ns, path) = reference.split_once(':')?;
+    let path = path.strip_prefix("textures/")?;
+    let file = root.join("assets").join(ns).join("textures").join(path);
+    let name = path.strip_suffix(".png").unwrap_or(path);
+    Some((format!("{ns}:{name}"), file))
+}
+
+/// The `assets/<ns>/<folder>/*.json` files of `root`, as (`<ns>:<name>`, file).
+pub fn asset_files(root: &Path, folder: &str) -> Vec<(String, PathBuf)> {
+    let mut out = Vec::new();
+    let Ok(namespaces) = fs::read_dir(root.join("assets")) else {
+        return out;
+    };
+    for ns in namespaces.flatten() {
+        let Some(namespace) = ns.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if namespace == "minecraft" {
+            continue;
+        }
+        let Ok(entries) = fs::read_dir(ns.path().join(folder)) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.extension().and_then(|e| e.to_str()) == Some("json")
+                && let Some(name) = path.file_stem().and_then(|s| s.to_str())
+            {
+                out.push((format!("{namespace}:{name}"), path.clone()));
+            }
+        }
+    }
+    out.sort();
+    out
+}
+
+fn read(path: &Path) -> Option<Value> {
+    serde_json::from_slice(&fs::read(path).ok()?).ok()
+}
+
+fn floats<const N: usize>(v: &Value) -> Option<[f32; N]> {
+    let a = v.as_array().filter(|a| a.len() >= N)?;
+    let mut out = [0.0; N];
+    for (o, x) in out.iter_mut().zip(a) {
+        *o = x.as_f64()? as f32;
+    }
+    Some(out)
+}
+
+fn lines(v: &Value) -> Vec<String> {
+    v.as_array()
+        .map(|a| {
+            a.iter()
+                .filter_map(|l| l.as_str().map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Reads one screen file.
+pub fn parse(root: &Path, doc: &Value) -> Result<ScreenDef, String> {
+    let texture = doc["texture"].as_str().ok_or("no texture")?;
+    let (sprite, file) =
+        texture_sprite(root, texture).ok_or("texture: not <ns>:textures/<path>")?;
+    let size = floats::<2>(&doc["size"]).unwrap_or([176.0, 166.0]);
+    let title = match &doc["title"] {
+        Value::Null => Some(([8.0, 6.0], false)),
+        t => floats::<2>(t).map(|p| (p, t.get(2).and_then(Value::as_str) == Some("center"))),
+    };
+    let title_color = doc["title_color"]
+        .as_str()
+        .and_then(|c| u32::from_str_radix(c.strip_prefix('#')?, 16).ok());
+    let inventory_label = match doc.get("inventory_label") {
+        None => Some([8.0, size[1] - 94.0]),
+        Some(v) => floats::<2>(v),
+    };
+    let dir = |v: &Value| match v.as_str() {
+        Some("up") => Dir::Up,
+        Some("down") => Dir::Down,
+        Some("left") => Dir::Left,
+        _ => Dir::Right,
+    };
+    let index = |v: &Value| v.as_u64().map(|i| i as usize);
+    let mut bars = Vec::new();
+    for b in doc["bars"].as_array().into_iter().flatten() {
+        let max = match (index(&b["max"]), b["max_value"].as_i64()) {
+            (Some(i), _) => Max::Value(i),
+            (None, Some(v)) => Max::Fixed(v as i32),
+            _ => return Err("a bar without max or max_value".into()),
+        };
+        bars.push(Bar {
+            value: index(&b["value"]).ok_or("a bar without value")?,
+            from: b["from"].as_i64().unwrap_or(0) as i32,
+            max,
+            rect: floats::<4>(&b["rect"]).ok_or("a bar without rect")?,
+            uv: floats::<2>(&b["uv"]),
+            color: index(&b["color"]),
+            dir: dir(&b["dir"]),
+        });
+    }
+    let gauges = doc["gauges"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|g| {
+            let max = match (index(&g["max"]), g["max_value"].as_i64()) {
+                (Some(i), _) => Max::Value(i),
+                (None, Some(v)) => Max::Fixed(v as i32),
+                _ => return None,
+            };
+            let f = |k: &str, d: f32| g[k].as_f64().map_or(d, |v| v as f32);
+            Some(Gauge {
+                value: index(&g["value"])?,
+                max,
+                at: floats::<2>(&g["at"])?,
+                tip: f("tip", 5.0),
+                back: f("back", 2.0),
+                side: f("side", 1.0),
+                color: g["color"]
+                    .as_str()
+                    .and_then(|c| u32::from_str_radix(c.strip_prefix('#')?, 16).ok())
+                    .unwrap_or(0x7f0000),
+            })
+        })
+        .collect();
+    let mut overlays = Vec::new();
+    for o in doc["overlays"].as_array().into_iter().flatten() {
+        let when = match (index(&o["slot"]), index(&o["value"])) {
+            (Some(s), _) => When::Slot(s),
+            (None, Some(i)) => When::Value {
+                index: i,
+                min: o["min"].as_i64().unwrap_or(1) as i32,
+                max: o["max"].as_i64().map_or(i32::MAX, |m| m as i32),
+            },
+            _ => return Err("an overlay without slot or value".into()),
+        };
+        overlays.push(Overlay {
+            when,
+            rect: floats::<4>(&o["rect"]).ok_or("an overlay without rect")?,
+            uv: floats::<2>(&o["uv"]).ok_or("an overlay without uv")?,
+        });
+    }
+    let tips = doc["tooltips"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|t| {
+            Some(Tip {
+                rect: floats::<4>(&t["rect"])?,
+                lines: lines(&t["lines"]),
+            })
+        })
+        .collect();
+    let buttons = doc["buttons"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|b| {
+            Some(Button {
+                id: b["id"].as_u64()? as u32,
+                shift: b["shift"].as_u64().map(|i| i as u32),
+                rect: floats::<4>(&b["rect"])?,
+                lines: lines(&b["lines"]),
+            })
+        })
+        .collect();
+    Ok(ScreenDef {
+        sprite,
+        file,
+        size,
+        title,
+        title_color,
+        inventory_label,
+        bars,
+        gauges,
+        overlays,
+        tips,
+        buttons,
+    })
+}
+
+/// Loads the screens of `root`, replacing those loaded before; how many.
+pub fn load(root: &Path) -> usize {
+    let mut map = HashMap::new();
+    for (name, path) in asset_files(root, "horizon_screen") {
+        match read(&path)
+            .ok_or_else(|| "not JSON".to_owned())
+            .and_then(|doc| parse(root, &doc))
+        {
+            Ok(def) => {
+                map.insert(name, Arc::new(def));
+            }
+            Err(e) => log::warn!("Horizon: machine screen {}: {e}", path.display()),
+        }
+    }
+    let n = map.len();
+    if let Ok(mut s) = SCREENS.write() {
+        *s = Some(Arc::new(map));
+    }
+    n
+}
+
+/// The screen `name` (`<namespace>:<name>`).
+pub fn get(name: &str) -> Option<Arc<ScreenDef>> {
+    SCREENS.read().ok()?.as_ref()?.get(name).cloned()
+}
+
+/// The textures the block models of `root` name: the GUI atlas packs these,
+/// and no other file of the mods' `textures/` (a machine screen's texture
+/// loads into a GUI slot when it opens: `hud::GUI_SLOTS`).
+pub fn textures(root: &Path) -> Vec<(String, PathBuf)> {
+    let mut out: Vec<(String, PathBuf)> = Vec::new();
+    for folder in ["horizon_model", "horizon_liquid"] {
+        for (_, path) in asset_files(root, folder) {
+            let Some(doc) = read(&path) else { continue };
+            let liquids = doc["liquids"].as_array().cloned().unwrap_or_default();
+            let named = std::iter::once(&doc)
+                .chain(&liquids)
+                .filter_map(|d| d["texture"].as_str().map(str::to_owned));
+            for t in named {
+                if let Some(found) = texture_sprite(root, &t)
+                    && !out.iter().any(|(n, _)| *n == found.0)
+                {
+                    out.push(found);
+                }
+            }
+        }
+    }
+    out
+}
+
+/// `{0}` is value 0; `{0:si}` writes it with an SI prefix (`12.5k`), as
+/// HBM's `BobMathUtil.getShortNumber`.
+pub fn format(line: &str, values: &[i32]) -> String {
+    let mut out = String::new();
+    let mut rest = line;
+    while let Some(start) = rest.find('{') {
+        out.push_str(&rest[..start]);
+        let Some(end) = rest[start..].find('}') else {
+            out.push_str(&rest[start..]);
+            return out;
+        };
+        let inner = &rest[start + 1..start + end];
+        let (index, si) = match inner.split_once(':') {
+            Some((i, "si")) => (i, true),
+            _ => (inner, false),
+        };
+        match index.parse::<usize>().ok().and_then(|i| values.get(i)) {
+            Some(&v) if si => out.push_str(&short_number(i64::from(v))),
+            Some(v) => out.push_str(&v.to_string()),
+            None => out.push_str(&rest[start..=start + end]),
+        }
+        rest = &rest[start + end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
+
+fn short_number(v: i64) -> String {
+    let a = v.unsigned_abs() as f64;
+    for (limit, suffix) in [(1e12, "T"), (1e9, "G"), (1e6, "M"), (1e3, "k")] {
+        if a >= limit {
+            let x = v as f64 / limit;
+            return format!("{}{suffix}", (x * 10.0).round() / 10.0);
+        }
+    }
+    v.to_string()
+}
+
+fn inside(r: [f32; 4], x: f32, y: f32) -> bool {
+    x >= r[0] && y >= r[1] && x < r[0] + r[2] && y < r[1] + r[3]
+}
+
+impl ScreenDef {
+    /// The part `[sx, sy, w, h]` of the texture at `[dx, dy]` on the screen.
+    fn blit(&self, batch: &mut HudBatch, atlas: &HudAtlas, src: [f32; 4], dx: f32, dy: f32) {
+        let Some(mut r) = atlas.sprites.get(&self.sprite).copied() else {
+            return;
+        };
+        let (du, dv) = ((r.u1 - r.u0) / r.w as f32, (r.v1 - r.v0) / r.h as f32);
+        r = Rect {
+            u0: r.u0 + src[0] * du,
+            v0: r.v0 + src[1] * dv,
+            u1: r.u0 + (src[0] + src[2]) * du,
+            v1: r.v0 + (src[1] + src[3]) * dv,
+            ..r
+        };
+        batch.rect_uv(dx, dy, src[2], src[3], r, u32::MAX);
+    }
+
+    /// Whether the GUI atlas holds the texture.
+    pub fn ready(&self, atlas: &HudAtlas) -> bool {
+        atlas.sprites.contains_key(&self.sprite)
+    }
+
+    /// The background, then the bars and overlays, at `(ox, oy)`.
+    pub fn draw(
+        &self,
+        batch: &mut HudBatch,
+        atlas: &HudAtlas,
+        ox: f32,
+        oy: f32,
+        values: &[i32],
+        filled: impl Fn(usize) -> bool,
+    ) {
+        self.blit(batch, atlas, [0.0, 0.0, self.size[0], self.size[1]], ox, oy);
+        let value = |i: usize| values.get(i).copied().unwrap_or(0);
+        for bar in &self.bars {
+            let max = match bar.max {
+                Max::Value(i) => value(i),
+                Max::Fixed(v) => v,
+            };
+            let Some(f) = fill(value(bar.value), bar.from, max) else {
+                continue;
+            };
+            let [x, y, w, h] = bar.rect;
+            // The part of the rect the value covers, as HBM's GUIs cut it.
+            let (cx, cy, cw, ch) = match bar.dir {
+                Dir::Right => (0.0, 0.0, (w * f).ceil(), h),
+                Dir::Left => (w - (w * f).ceil(), 0.0, (w * f).ceil(), h),
+                Dir::Up => (0.0, h - (h * f).ceil(), w, (h * f).ceil()),
+                Dir::Down => (0.0, 0.0, w, (h * f).ceil()),
+            };
+            if cw <= 0.0 || ch <= 0.0 {
+                continue;
+            }
+            if let Some([u, v]) = bar.uv {
+                self.blit(
+                    batch,
+                    atlas,
+                    [u + cx, v + cy, cw, ch],
+                    ox + x + cx,
+                    oy + y + cy,
+                );
+            } else if let Some(c) = bar.color {
+                let rgb = value(c) as u32;
+                let color = crate::hud::rgba((rgb >> 16) as u8, (rgb >> 8) as u8, rgb as u8, 255);
+                batch.fill(atlas, ox + x + cx, oy + y + cy, cw, ch, color);
+            }
+        }
+        for g in &self.gauges {
+            let max = match g.max {
+                Max::Value(i) => value(i),
+                Max::Fixed(v) => v,
+            };
+            let Some(f) = fill(value(g.value), 0, max) else {
+                continue;
+            };
+            let [cx, cy] = [ox + g.at[0], oy + g.at[1]];
+            let [r, gr, b] = [(g.color >> 16) as u8, (g.color >> 8) as u8, g.color as u8];
+            for (mult, color) in [
+                (1.5, crate::hud::rgba(0, 0, 0, 255)),
+                (1.0, crate::hud::rgba(r, gr, b, 255)),
+            ] {
+                let [t, l, rt] =
+                    needle(f, g.tip, g.back, g.side, mult).map(|[x, y]| [cx + x, cy + y]);
+                batch.fill_quad(atlas, [t, l, rt, rt], color);
+            }
+        }
+        for o in &self.overlays {
+            let on = match o.when {
+                When::Slot(s) => filled(s),
+                When::Value { index, min, max } => (min..=max).contains(&value(index)),
+            };
+            if on {
+                let [x, y, w, h] = o.rect;
+                self.blit(batch, atlas, [o.uv[0], o.uv[1], w, h], ox + x, oy + y);
+            }
+        }
+    }
+
+    /// The tooltip under the pointer (screen-relative), filled in.
+    pub fn tooltip(&self, x: f32, y: f32, values: &[i32]) -> Option<Vec<String>> {
+        let lines = self
+            .tips
+            .iter()
+            .find(|t| inside(t.rect, x, y))
+            .map(|t| &t.lines)
+            .or_else(|| {
+                self.buttons
+                    .iter()
+                    .find(|b| inside(b.rect, x, y) && !b.lines.is_empty())
+                    .map(|b| &b.lines)
+            })?;
+        Some(lines.iter().map(|l| format(l, values)).collect())
+    }
+
+    /// The button under the pointer (screen-relative).
+    /// The id the button under `(x, y)` sends, `shift` held or not.
+    pub fn button_at(&self, x: f32, y: f32, shift: bool) -> Option<u32> {
+        self.buttons
+            .iter()
+            .find(|b| inside(b.rect, x, y))
+            .map(|b| b.shift.filter(|_| shift).unwrap_or(b.id))
+    }
+}
+
+/// The share of a bar `value` fills between `from` and `max`; None for a
+/// bar with nothing to show (`max` not above `from`).
+fn fill(value: i32, from: i32, max: i32) -> Option<f32> {
+    let span = i64::from(max) - i64::from(from);
+    (span > 0).then(|| ((i64::from(value) - i64::from(from)) as f32 / span as f32).clamp(0.0, 1.0))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lines_take_values() {
+        assert_eq!(
+            format("{0:si} / {1:si} HE", &[12_500, 1_000_000]),
+            "12.5k / 1M HE"
+        );
+        assert_eq!(format("{2} ticks {x}", &[1, 2, 3]), "3 ticks {x}");
+    }
+
+    #[test]
+    fn a_needle_turns_from_lower_left_to_lower_right() {
+        let at = |p| needle(p, 5.0, 2.0, 1.0, 1.0)[0];
+        let close =
+            |a: [f32; 2], b: [f32; 2]| (a[0] - b[0]).abs() < 1e-4 && (a[1] - b[1]).abs() < 1e-4;
+        let d = 5.0 * std::f32::consts::FRAC_1_SQRT_2;
+        // GUI y points down: 0 at the lower left, half at the top, 1 at the lower right.
+        assert!(close(at(0.0), [-d, d]), "{:?}", at(0.0));
+        assert!(close(at(0.5), [0.0, -5.0]), "{:?}", at(0.5));
+        assert!(close(at(1.0), [d, d]), "{:?}", at(1.0));
+        assert!(close(at(2.0), at(1.0)));
+    }
+
+    #[test]
+    fn a_bar_fills_from_its_start() {
+        assert_eq!(fill(50, 0, 100), Some(0.5));
+        // The second of four columns: empty below 250, full from 500.
+        assert_eq!(fill(100, 250, 500), Some(0.0));
+        assert_eq!(fill(375, 250, 500), Some(0.5));
+        assert_eq!(fill(900, 250, 500), Some(1.0));
+        assert_eq!(fill(5, 0, 0), None);
+        assert_eq!(fill(i32::MAX, i32::MIN, i32::MAX), Some(1.0));
+    }
+
+    #[test]
+    fn a_screen_reads() {
+        let doc: Value = serde_json::from_str(
+            r#"{"texture":"ntm:textures/gui/a.png","size":[176,256],"title":[70,6,"center"],
+                "bars":[{"value":0,"max":1,"rect":[1,2,3,4],"uv":[176,0],"dir":"up"}],
+                "overlays":[{"slot":0,"rect":[1,1,2,2],"uv":[3,3]}],
+                "tooltips":[{"rect":[0,0,10,10],"lines":["{0}"]}],
+                "buttons":[{"id":2,"rect":[20,20,5,5]},{"id":3,"shift":4,"rect":[30,30,5,5]}]}"#,
+        )
+        .unwrap();
+        let def = parse(Path::new("/r"), &doc).unwrap();
+        assert_eq!(def.sprite, "ntm:gui/a");
+        assert_eq!(def.title, Some(([70.0, 6.0], true)));
+        assert_eq!(def.title_color, None);
+        assert_eq!(def.inventory_label, Some([8.0, 162.0]));
+        assert_eq!(def.tooltip(5.0, 5.0, &[42]), Some(vec!["42".into()]));
+        assert_eq!(def.button_at(21.0, 21.0, false), Some(2));
+        assert_eq!(def.button_at(21.0, 21.0, true), Some(2));
+        assert_eq!(def.button_at(31.0, 31.0, false), Some(3));
+        assert_eq!(def.button_at(31.0, 31.0, true), Some(4));
+        assert_eq!(def.button_at(0.0, 0.0, false), None);
+    }
+}
