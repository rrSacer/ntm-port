diff --git a/crates/horizon-client-render/src/mod_models.rs b/crates/horizon-client-render/src/mod_models.rs
new file mode 100644
index 000000000..0c1d0dac0
--- /dev/null
+++ b/crates/horizon-client-render/src/mod_models.rs
@@ -0,0 +1,836 @@
+//! Models of content mods' blocks drawn by the block-entity renderer: a
+//! Wavefront OBJ with its own texture, turned by the block's `facing`, whose
+//! objects are bones that animations move (GeckoLib's Bedrock animation
+//! format, numbers only). Each `assets/<namespace>/horizon_model/<name>.json`
+//! of the resource root draws the block `<namespace>:<name>`.
+//!
+//! ```text
+//! {
+//!   "obj": "ntm:models/obj/assembly_machine.obj",
+//!   "texture": "ntm:textures/models/machines/assembly_machine.png",
+//!   "rotation": 90,            degrees about y before the facing's turn (north 0, west 90,
+//!                              south 180, east 270), as HBM's renderers turn by metadata
+//!   "translate": [0, 0, 0],    blocks, in the model's frame, before both turns
+//!   "scale": 1.0,
+//!   "radius": 2.5,             blocks from the block's centre the model reaches (culling)
+//!   "hide": ["Ring2"],         objects not drawn
+//!   "bones": {"ArmLower1": {"pivot": [0, 1.625, 0.9375], "parent": "Ring"}},
+//!   "animations": "ntm:animations/assembly_machine.animation.json",
+//!   "play": [{"animation": "animation.assembler.work", "property": "honey_level", "not": "0"}],
+//!   "show": {"InnerBurning": {"property": "honey_level", "not": "0"}},   objects drawn only so
+//!   "glow": ["InnerBurning"]   drawn at full light (HBM's lightmap 240, 240)
+//! }
+//! ```
+//!
+//! An animation file is GeckoLib's: `{"animations": {"<name>": {"loop": true,
+//! "animation_length": 4.0, "bones": {"<bone>": {"rotation": {"0.0": [x, y, z],
+//! ...}, "position": {...}}}}}}`. Rotations are degrees about the bone's
+//! pivot (applied z, y, then x), positions are pixels (1/16 block), both
+//! interpolated linearly between keyframes; a channel may be one constant
+//! `[x, y, z]`. A bone's transform applies to its children too.
+//!
+//! `"liquids"` (in a model, or alone in `horizon_liquid/<name>.json` for a
+//! block that keeps its own blockstate model) are boxes of molten metal, as
+//! HBM's foundry renderers draw them with `lava_gray`:
+//!
+//! ```text
+//! {"texture": "ntm:textures/models/machines/lava_gray.png",
+//!  "box": [0.125, 0.125, 0.125, 0.875, 0.875, 0.875],   blocks, turned with the model
+//!  "value": 0, "max": 1,     its top face at value / max of the height (indices; no max: full)
+//!  "color": 2,               the value holding 0xRRGGBB; 0 draws nothing
+//!  "column": false}          a jet: the box's four sides, while its colour is set
+//! ```
+//!
+//! The values are the machine's synced ones (`horizon_world::mod_machines`).
+use crate::{
+    block_entity_render::{Paint, diffuse},
+    hud::Rect,
+    mesher::Vertex,
+};
+use glam::{Mat4, Quat, Vec3};
+use serde_json::Value;
+use std::{
+    fs,
+    io::BufReader,
+    path::{Path, PathBuf},
+};
+
+/// One OBJ object: its triangles (position, UV, normal) in blocks.
+#[derive(Clone, Debug, Default)]
+pub struct Bone {
+    pub name: String,
+    pub parent: Option<usize>,
+    pub pivot: Vec3,
+    pub hidden: bool,
+    /// Drawn at full light, whatever the block's.
+    pub glow: bool,
+    pub triangles: Vec<[(Vec3, [f32; 2], Vec3); 3]>,
+}
+
+#[derive(Clone, Debug, Default)]
+struct Channel {
+    rotation: Vec<(f32, Vec3)>,
+    position: Vec<(f32, Vec3)>,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Animation {
+    pub name: String,
+    pub length: f32,
+    pub looping: bool,
+    channels: Vec<(usize, Channel)>,
+}
+
+/// A liquid the model shows as HBM's foundry renderers do (`RenderFoundry`):
+/// the top of `bounds` (block coordinates, 0 to 1 on a block, turned with
+/// the facing) at `value / max` of its height, the texture tinted by the
+/// 0xRRGGBB in `color` (none while 0); a `column` (a pour) shows its sides,
+/// whole, while its colour is set.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Liquid {
+    pub bounds: [f32; 6],
+    pub value: usize,
+    pub max: Option<usize>,
+    pub color: usize,
+    pub sprite: String,
+    pub column: bool,
+}
+
+/// Which animation a block state plays: `property` is (or is not) `value`.
+#[derive(Clone, Debug)]
+pub struct Play {
+    pub animation: usize,
+    pub property: String,
+    pub is: Option<String>,
+    pub not: Option<String>,
+}
+
+impl Play {
+    /// Whether the block state's property is (or is not) the value asked.
+    fn matches(&self, prop: &dyn Fn(&str) -> Option<String>) -> bool {
+        prop(&self.property).is_some_and(|v| {
+            self.is.as_ref().is_none_or(|is| *is == v)
+                && self.not.as_ref().is_none_or(|not| *not != v)
+        })
+    }
+}
+
+/// Sky and block light 15, packed as a vertex's (`block_entity_render::vertex_light`).
+pub const FULL_LIGHT: u32 = 240 | 240 << 8;
+
+#[derive(Clone, Debug, Default)]
+pub struct Model {
+    pub block: String,
+    /// The texture's sprite in the GUI atlas: `ntm:models/machines/assembly_machine`.
+    pub sprite: String,
+    pub bones: Vec<Bone>,
+    pub rotation: f32,
+    pub translate: Vec3,
+    pub scale: f32,
+    pub radius: f32,
+    pub animations: Vec<Animation>,
+    pub play: Vec<Play>,
+    /// Bones shown only while a block state property matches (HBM's
+    /// renderers draw `InnerBurning` or `InnerEmpty` by `wasOn`).
+    pub show: Vec<(usize, Play)>,
+    pub liquids: Vec<Liquid>,
+    /// Bones no animation moves, nor their ancestors: drawn from a cache.
+    pub still: Vec<bool>,
+    /// Triangles in the model.
+    pub triangles: usize,
+}
+
+/// `ntm:models/x.obj` under `root`: `assets/ntm/models/x.obj`.
+fn reference_path(root: &Path, reference: &str) -> Option<PathBuf> {
+    let (ns, path) = reference.split_once(':')?;
+    Some(root.join("assets").join(ns).join(path))
+}
+
+fn vec3(v: &Value) -> Option<Vec3> {
+    let a = v.as_array().filter(|a| a.len() == 3)?;
+    Some(Vec3::new(
+        a[0].as_f64()? as f32,
+        a[1].as_f64()? as f32,
+        a[2].as_f64()? as f32,
+    ))
+}
+
+/// A Bedrock keyframe channel: one constant vector, or times to vectors.
+fn keyframes(v: &Value) -> Vec<(f32, Vec3)> {
+    if let Some(c) = vec3(v) {
+        return vec![(0.0, c)];
+    }
+    let mut out: Vec<(f32, Vec3)> = v
+        .as_object()
+        .into_iter()
+        .flatten()
+        .filter_map(|(t, k)| {
+            let k = k.get("post").unwrap_or(k);
+            Some((t.parse::<f32>().ok()?, vec3(k)?))
+        })
+        .collect();
+    out.sort_by(|a, b| a.0.total_cmp(&b.0));
+    out
+}
+
+fn sample(keys: &[(f32, Vec3)], t: f32) -> Vec3 {
+    match keys {
+        [] => Vec3::ZERO,
+        [(_, v)] => *v,
+        _ => {
+            let i = keys.partition_point(|k| k.0 <= t);
+            if i == 0 {
+                return keys[0].1;
+            }
+            if i == keys.len() {
+                return keys[i - 1].1;
+            }
+            let (t0, a) = keys[i - 1];
+            let (t1, b) = keys[i];
+            a.lerp(b, if t1 > t0 { (t - t0) / (t1 - t0) } else { 0.0 })
+        }
+    }
+}
+
+fn read_obj(path: &Path) -> Result<Vec<(String, Vec<[(Vec3, [f32; 2], Vec3); 3]>)>, String> {
+    let file = fs::File::open(path).map_err(|e| e.to_string())?;
+    let options = tobj::LoadOptions {
+        triangulate: true,
+        single_index: true,
+        ..Default::default()
+    };
+    let (models, _) = tobj::load_obj_buf(&mut BufReader::new(file), &options, |_| {
+        Err(tobj::LoadError::OpenFileFailed)
+    })
+    .map_err(|e| e.to_string())?;
+    let mut out = Vec::new();
+    for m in models {
+        let mesh = &m.mesh;
+        let at = |i: u32| {
+            let i = i as usize;
+            let p = Vec3::new(
+                mesh.positions[3 * i],
+                mesh.positions[3 * i + 1],
+                mesh.positions[3 * i + 2],
+            );
+            // HFRWavefrontObject (and Forge's loader) read v as 1 - v.
+            let uv = if mesh.texcoords.len() >= 2 * i + 2 {
+                [mesh.texcoords[2 * i], 1.0 - mesh.texcoords[2 * i + 1]]
+            } else {
+                [0.0, 0.0]
+            };
+            let n = if mesh.normals.len() >= 3 * i + 3 {
+                Vec3::new(
+                    mesh.normals[3 * i],
+                    mesh.normals[3 * i + 1],
+                    mesh.normals[3 * i + 2],
+                )
+            } else {
+                Vec3::ZERO
+            };
+            (p, uv, n)
+        };
+        let mut tris = Vec::with_capacity(mesh.indices.len() / 3);
+        for t in mesh.indices.as_chunks::<3>().0 {
+            let mut tri = [at(t[0]), at(t[1]), at(t[2])];
+            // A face without normals is lit by its own plane.
+            let flat = (tri[1].0 - tri[0].0)
+                .cross(tri[2].0 - tri[0].0)
+                .normalize_or(Vec3::Y);
+            for v in &mut tri {
+                if v.2 == Vec3::ZERO {
+                    v.2 = flat;
+                }
+            }
+            tris.push(tri);
+        }
+        // Objects of one name (`o` twice) join.
+        match out
+            .iter_mut()
+            .find(|(n, _): &&mut (String, Vec<_>)| *n == m.name)
+        {
+            Some((_, t)) => t.extend(tris),
+            None => out.push((m.name.clone(), tris)),
+        }
+    }
+    Ok(out)
+}
+
+fn read_animations(path: &Path, bones: &[Bone]) -> Result<Vec<Animation>, String> {
+    let doc: Value = serde_json::from_slice(&fs::read(path).map_err(|e| e.to_string())?)
+        .map_err(|e| e.to_string())?;
+    let mut out = Vec::new();
+    for (name, a) in doc["animations"].as_object().ok_or("no animations")? {
+        let mut channels = Vec::new();
+        for (bone, c) in a["bones"].as_object().into_iter().flatten() {
+            let Some(i) = bones.iter().position(|b| b.name == *bone) else {
+                continue;
+            };
+            channels.push((
+                i,
+                Channel {
+                    rotation: keyframes(&c["rotation"]),
+                    position: keyframes(&c["position"]),
+                },
+            ));
+        }
+        out.push(Animation {
+            name: name.clone(),
+            length: a["animation_length"].as_f64().unwrap_or(1.0) as f32,
+            looping: a["loop"].as_bool().unwrap_or(false),
+            channels,
+        });
+    }
+    Ok(out)
+}
+
+/// Reads one model file.
+pub fn parse(root: &Path, block: &str, doc: &Value) -> Result<Model, String> {
+    let mut liquids = Vec::new();
+    for l in doc["liquids"].as_array().into_iter().flatten() {
+        let b = l["box"]
+            .as_array()
+            .filter(|b| b.len() == 6)
+            .ok_or("a liquid without box")?;
+        let mut bounds = [0.0; 6];
+        for (o, v) in bounds.iter_mut().zip(b) {
+            *o = v.as_f64().ok_or("a liquid's box: not numbers")? as f32;
+        }
+        let t = l["texture"].as_str().ok_or("a liquid without texture")?;
+        let (sprite, _) = crate::mod_screens::texture_sprite(root, t)
+            .ok_or("a liquid's texture: not <ns>:textures/<path>")?;
+        liquids.push(Liquid {
+            bounds,
+            value: l["value"].as_u64().unwrap_or(0) as usize,
+            max: l["max"].as_u64().map(|m| m as usize),
+            color: l["color"].as_u64().ok_or("a liquid without color")? as usize,
+            sprite,
+            column: l["column"].as_bool().unwrap_or(false),
+        });
+    }
+    // A liquid file (`horizon_liquid`) has no OBJ: the block's own model stays.
+    let Some(obj) = doc["obj"].as_str() else {
+        return Ok(Model {
+            block: block.to_owned(),
+            scale: 1.0,
+            radius: doc["radius"].as_f64().unwrap_or(1.0) as f32,
+            liquids,
+            ..Default::default()
+        });
+    };
+    let obj = reference_path(root, obj).ok_or("obj: not <ns>:<path>")?;
+    let texture = doc["texture"].as_str().ok_or("no texture")?;
+    let (sprite, _) = crate::mod_screens::texture_sprite(root, texture)
+        .ok_or("texture: not <ns>:textures/<path>")?;
+    let hide: Vec<&str> = doc["hide"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(Value::as_str)
+        .collect();
+    let mut bones: Vec<Bone> = read_obj(&obj)
+        .map_err(|e| format!("{}: {e}", obj.display()))?
+        .into_iter()
+        .map(|(name, triangles)| Bone {
+            hidden: hide.contains(&name.as_str()),
+            glow: doc["glow"]
+                .as_array()
+                .is_some_and(|g| g.iter().any(|v| v.as_str() == Some(name.as_str()))),
+            name,
+            parent: None,
+            pivot: Vec3::ZERO,
+            triangles,
+        })
+        .collect();
+    let spec = &doc["bones"];
+    for i in 0..bones.len() {
+        let b = &spec[&bones[i].name];
+        bones[i].pivot = vec3(&b["pivot"]).unwrap_or(Vec3::ZERO);
+        bones[i].parent = b["parent"]
+            .as_str()
+            .and_then(|p| bones.iter().position(|o| o.name == p))
+            .filter(|&p| p != i);
+    }
+    // A parent chain that loops back is cut.
+    for i in 0..bones.len() {
+        let mut seen = 0;
+        let mut at = bones[i].parent;
+        while let Some(p) = at {
+            seen += 1;
+            if p == i || seen > bones.len() {
+                bones[i].parent = None;
+                break;
+            }
+            at = bones[p].parent;
+        }
+    }
+    let animations = match doc["animations"].as_str() {
+        Some(a) => {
+            let path = reference_path(root, a).ok_or("animations: not <ns>:<path>")?;
+            read_animations(&path, &bones).map_err(|e| format!("{}: {e}", path.display()))?
+        }
+        None => Vec::new(),
+    };
+    let play = doc["play"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|p| {
+            Some(Play {
+                animation: animations
+                    .iter()
+                    .position(|a| Some(a.name.as_str()) == p["animation"].as_str())?,
+                property: p["property"].as_str()?.to_owned(),
+                is: p["is"].as_str().map(str::to_owned),
+                not: p["not"].as_str().map(str::to_owned),
+            })
+        })
+        .collect();
+    let show = doc["show"]
+        .as_object()
+        .into_iter()
+        .flatten()
+        .filter_map(|(bone, c)| {
+            Some((
+                bones.iter().position(|b| b.name == *bone)?,
+                Play {
+                    animation: 0,
+                    property: c["property"].as_str()?.to_owned(),
+                    is: c["is"].as_str().map(str::to_owned),
+                    not: c["not"].as_str().map(str::to_owned),
+                },
+            ))
+        })
+        .collect();
+    let moved: Vec<bool> = (0..bones.len())
+        .map(|i| {
+            animations
+                .iter()
+                .any(|a| a.channels.iter().any(|(b, _)| *b == i))
+        })
+        .collect();
+    let still = (0..bones.len())
+        .map(|i| {
+            let mut at = Some(i);
+            while let Some(b) = at {
+                if moved[b] {
+                    return false;
+                }
+                at = bones[b].parent;
+            }
+            true
+        })
+        .collect();
+    let triangles = bones
+        .iter()
+        .filter(|b| !b.hidden)
+        .map(|b| b.triangles.len())
+        .sum();
+    Ok(Model {
+        block: block.to_owned(),
+        sprite,
+        bones,
+        rotation: doc["rotation"].as_f64().unwrap_or(0.0) as f32,
+        translate: vec3(&doc["translate"]).unwrap_or(Vec3::ZERO),
+        scale: doc["scale"].as_f64().unwrap_or(1.0) as f32,
+        radius: doc["radius"].as_f64().unwrap_or(1.0) as f32,
+        animations,
+        play,
+        show,
+        liquids,
+        still,
+        triangles,
+    })
+}
+
+/// Every model of `root`, by block: OBJ models and liquid files.
+pub fn load(root: &Path) -> Vec<Model> {
+    let mut out = Vec::new();
+    let files = crate::mod_screens::asset_files(root, "horizon_model")
+        .into_iter()
+        .chain(crate::mod_screens::asset_files(root, "horizon_liquid"));
+    for (block, path) in files {
+        let doc = fs::read(&path)
+            .ok()
+            .and_then(|b| serde_json::from_slice::<Value>(&b).ok());
+        match doc
+            .ok_or_else(|| "not JSON".to_owned())
+            .and_then(|d| parse(root, &block, &d))
+        {
+            Ok(m) => out.push(m),
+            Err(e) => log::warn!("Horizon: block model {}: {e}", path.display()),
+        }
+    }
+    out
+}
+
+/// `facing`'s turn as HBM's renderers make it from the block's metadata.
+pub fn facing_yaw(facing: Option<&str>) -> f32 {
+    match facing {
+        Some("west") => 90.0,
+        Some("south") => 180.0,
+        Some("east") => 270.0,
+        _ => 0.0,
+    }
+}
+
+impl Model {
+    /// The animation a state with these properties plays, if any.
+    pub fn playing(&self, prop: &dyn Fn(&str) -> Option<String>) -> Option<usize> {
+        self.play
+            .iter()
+            .find_map(|p| p.matches(prop).then_some(p.animation))
+    }
+
+    /// The bones a block state hides by `show` (bit `i` for bone `i`; bones
+    /// past 63 are always shown).
+    pub fn hidden_by(&self, prop: &dyn Fn(&str) -> Option<String>) -> u64 {
+        self.show
+            .iter()
+            .filter(|(b, c)| *b < 64 && !c.matches(prop))
+            .fold(0, |m, (b, _)| m | 1 << b)
+    }
+
+    /// The block-space transform of the whole model for a turn of `yaw`
+    /// degrees: the block's centre, the turn, the scale and translation.
+    pub fn base(&self, yaw: f32) -> Mat4 {
+        Mat4::from_translation(Vec3::new(0.5, 0.0, 0.5))
+            * Mat4::from_rotation_y((yaw + self.rotation).to_radians())
+            * Mat4::from_scale(Vec3::splat(self.scale))
+            * Mat4::from_translation(self.translate)
+    }
+
+    /// Each bone's transform in the model's frame, `animation` at `t`
+    /// seconds. At rest, the first animation's first frame: HBM's parts stay
+    /// where their `anim` left them, which for a slide (`BobMathUtil.sps`) is
+    /// not the OBJ's own place.
+    pub fn pose(&self, animation: Option<usize>, t: f32) -> Vec<Mat4> {
+        let (animation, t) = match animation {
+            Some(a) => (Some(a), t),
+            None => ((!self.animations.is_empty()).then_some(0), 0.0),
+        };
+        let mut local = vec![Mat4::IDENTITY; self.bones.len()];
+        if let Some(a) = animation.and_then(|a| self.animations.get(a)) {
+            let t = if a.looping && a.length > 0.0 {
+                t.rem_euclid(a.length)
+            } else {
+                t.min(a.length)
+            };
+            for (b, c) in &a.channels {
+                let r = sample(&c.rotation, t) * (std::f32::consts::PI / 180.0);
+                let p = sample(&c.position, t) / 16.0;
+                let pivot = self.bones[*b].pivot;
+                local[*b] = Mat4::from_translation(p)
+                    * Mat4::from_translation(pivot)
+                    * Mat4::from_quat(Quat::from_euler(glam::EulerRot::ZYX, r.z, r.y, r.x))
+                    * Mat4::from_translation(-pivot);
+            }
+        }
+        let mut world = vec![Mat4::IDENTITY; self.bones.len()];
+        let mut done = vec![false; self.bones.len()];
+        fn resolve(i: usize, m: &Model, local: &[Mat4], world: &mut [Mat4], done: &mut [bool]) {
+            if done[i] {
+                return;
+            }
+            let parent = match m.bones[i].parent {
+                Some(p) => {
+                    resolve(p, m, local, world, done);
+                    world[p]
+                }
+                None => Mat4::IDENTITY,
+            };
+            world[i] = parent * local[i];
+            done[i] = true;
+        }
+        for i in 0..self.bones.len() {
+            resolve(i, self, &local, &mut world, &mut done);
+        }
+        world
+    }
+
+    /// The liquids at `data` (the block entity's values), as quads placed
+    /// by `place` (the block's corner, camera-relative) and turned by `yaw`.
+    pub fn emit_liquids(
+        &self,
+        data: &[i32],
+        yaw: f32,
+        place: Mat4,
+        light: u32,
+        sprites: &std::collections::HashMap<String, Rect>,
+        out: &mut Vec<Vertex>,
+    ) {
+        let value = |i: usize| data.get(i).copied().unwrap_or(0);
+        let m = place
+            * Mat4::from_translation(Vec3::new(0.5, 0.0, 0.5))
+            * Mat4::from_rotation_y(yaw.to_radians())
+            * Mat4::from_translation(Vec3::new(-0.5, 0.0, -0.5));
+        for l in &self.liquids {
+            let rgb = value(l.color) as u32 & 0xFF_FFFF;
+            if rgb == 0 {
+                continue;
+            }
+            let Some(r) = sprites.get(&l.sprite).copied() else {
+                continue;
+            };
+            let [x0, y0, z0, x1, y1, z1] = l.bounds;
+            let color = 255 << 24 | (rgb & 255) << 16 | (rgb >> 8 & 255) << 8 | rgb >> 16;
+            let mut quad = |corners: [Vec3; 4]| {
+                let uvs = [[r.u0, r.v0], [r.u0, r.v1], [r.u1, r.v1], [r.u1, r.v0]];
+                for (c, uv) in corners.into_iter().zip(uvs) {
+                    out.push(Vertex {
+                        pos: m.transform_point3(c).to_array(),
+                        uv,
+                        layer: 0,
+                        color,
+                        light,
+                        normal: [0; 4],
+                        glint_uv: [0.0, 0.0],
+                    });
+                }
+            };
+            let v = Vec3::new;
+            if l.column {
+                quad([v(x0, y0, z0), v(x0, y1, z0), v(x1, y1, z0), v(x1, y0, z0)]);
+                quad([v(x1, y0, z1), v(x1, y1, z1), v(x0, y1, z1), v(x0, y0, z1)]);
+                quad([v(x0, y0, z1), v(x0, y1, z1), v(x0, y1, z0), v(x0, y0, z0)]);
+                quad([v(x1, y0, z0), v(x1, y1, z0), v(x1, y1, z1), v(x1, y0, z1)]);
+                continue;
+            }
+            let f = match l.max {
+                Some(max) if value(max) > 0 => {
+                    (value(l.value) as f32 / value(max) as f32).clamp(0.0, 1.0)
+                }
+                Some(_) => 0.0,
+                None => 1.0,
+            };
+            if f <= 0.0 {
+                continue;
+            }
+            let y = y0 + (y1 - y0) * f;
+            quad([v(x0, y, z0), v(x0, y, z1), v(x1, y, z1), v(x1, y, z0)]);
+        }
+    }
+
+    /// Bone `bone` as quads in the model's frame, for the GPU to pose: its
+    /// UVs on `sprite`, its normals for the shader to light (`w` 127), white.
+    pub fn bone_mesh(&self, bone: usize, sprite: Rect) -> Vec<Vertex> {
+        let Some(b) = self.bones.get(bone).filter(|b| !b.hidden) else {
+            return Vec::new();
+        };
+        let snorm = |v: f32| (v.clamp(-1.0, 1.0) * 127.0).round() as i8;
+        let mut out = Vec::with_capacity(b.triangles.len() * 4);
+        for tri in &b.triangles {
+            for (p, uv, n) in [tri[0], tri[1], tri[2], tri[2]] {
+                let n = n.normalize_or(Vec3::Y);
+                out.push(Vertex {
+                    pos: p.to_array(),
+                    uv: [
+                        sprite.u0 + (sprite.u1 - sprite.u0) * uv[0],
+                        sprite.v0 + (sprite.v1 - sprite.v0) * uv[1],
+                    ],
+                    layer: 0,
+                    color: u32::MAX,
+                    light: 0,
+                    normal: [snorm(n.x), snorm(n.y), snorm(n.z), 127],
+                    glint_uv: [0.0, 0.0],
+                });
+            }
+        }
+        out
+    }
+
+    /// The bones `pick` keeps, posed, as quads (a triangle repeats its
+    /// last corner): `base` places them, `paint` lights and textures them.
+    pub fn emit(
+        &self,
+        pick: impl Fn(usize) -> bool,
+        pose: &[Mat4],
+        base: Mat4,
+        paint: Paint,
+        out: &mut Vec<Vertex>,
+    ) {
+        let r: Rect = paint.sprite;
+        for (i, bone) in self.bones.iter().enumerate() {
+            if bone.hidden || !pick(i) {
+                continue;
+            }
+            let light = if bone.glow { FULL_LIGHT } else { paint.light };
+            let m = base * pose[i];
+            for tri in &bone.triangles {
+                let corners = [tri[0], tri[1], tri[2], tri[2]];
+                for (p, uv, n) in corners {
+                    let normal = m.transform_vector3(n).normalize_or(Vec3::Y);
+                    let shade = diffuse(normal, paint.lights);
+                    let c = |shift: u32| (((paint.tint >> shift) & 255) as f32 * shade) as u32;
+                    out.push(Vertex {
+                        pos: m.transform_point3(p).to_array(),
+                        uv: [r.u0 + (r.u1 - r.u0) * uv[0], r.v0 + (r.v1 - r.v0) * uv[1]],
+                        layer: 0,
+                        color: 255 << 24 | c(0) << 16 | c(8) << 8 | c(16),
+                        light,
+                        normal: [0; 4],
+                        glint_uv: [0.0, 0.0],
+                    });
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keyframes_interpolate_and_loop() {
+        let keys =
+            keyframes(&serde_json::json!({"0.0": [0, 0, 0], "1.0": [0, 90, 0], "2.0": [0, 0, 0]}));
+        assert_eq!(sample(&keys, 0.5), Vec3::new(0.0, 45.0, 0.0));
+        assert_eq!(sample(&keys, 3.0), Vec3::ZERO);
+        assert_eq!(
+            keyframes(&serde_json::json!([1, 2, 3])),
+            vec![(0.0, Vec3::new(1.0, 2.0, 3.0))]
+        );
+    }
+
+    #[test]
+    fn a_liquid_rises_with_its_value_and_hides_without_colour() {
+        let m = Model {
+            liquids: vec![
+                Liquid {
+                    bounds: [0.125, 0.125, 0.125, 0.875, 0.375, 0.875],
+                    value: 0,
+                    max: Some(1),
+                    color: 2,
+                    sprite: "s".into(),
+                    column: false,
+                },
+                Liquid {
+                    bounds: [0.4, -1.0, 0.4, 0.6, 0.5, 0.6],
+                    value: 0,
+                    max: None,
+                    color: 3,
+                    sprite: "s".into(),
+                    column: true,
+                },
+            ],
+            ..Default::default()
+        };
+        let sprites: std::collections::HashMap<String, Rect> = [(
+            "s".to_string(),
+            Rect {
+                u0: 0.0,
+                v0: 0.0,
+                u1: 1.0,
+                v1: 1.0,
+                w: 16,
+                h: 16,
+            },
+        )]
+        .into();
+        let mut out = Vec::new();
+        m.emit_liquids(
+            &[72, 144, 0xFF8000, 0],
+            0.0,
+            Mat4::IDENTITY,
+            0,
+            &sprites,
+            &mut out,
+        );
+        assert_eq!(out.len(), 4, "half full, its pour stopped");
+        assert!((out[0].pos[1] - 0.25).abs() < 1e-5);
+        assert_eq!(out[0].color, 255 << 24 | 0x00 << 16 | 0x80 << 8 | 0xFF);
+        out.clear();
+        m.emit_liquids(
+            &[72, 144, 0, 0x00FF00],
+            0.0,
+            Mat4::IDENTITY,
+            0,
+            &sprites,
+            &mut out,
+        );
+        assert_eq!(out.len(), 16, "no colour, no level; the pour's four sides");
+    }
+
+    #[test]
+    fn a_child_follows_its_parent() {
+        let bone = |name: &str, parent: Option<usize>| Bone {
+            name: name.into(),
+            parent,
+            ..Default::default()
+        };
+        let mut m = Model {
+            bones: vec![bone("ring", None), bone("arm", Some(0))],
+            scale: 1.0,
+            ..Default::default()
+        };
+        m.animations.push(Animation {
+            name: "spin".into(),
+            length: 4.0,
+            looping: true,
+            channels: vec![(
+                0,
+                Channel {
+                    rotation: vec![(0.0, Vec3::ZERO), (4.0, Vec3::new(0.0, 360.0, 0.0))],
+                    position: Vec::new(),
+                },
+            )],
+        });
+        let pose = m.pose(Some(0), 1.0);
+        let p = pose[1].transform_point3(Vec3::X);
+        assert!((p - Vec3::new(0.0, 0.0, -1.0)).length() < 1e-4, "{p}");
+    }
+
+    #[test]
+    fn a_state_shows_one_inner_part_or_the_other() {
+        let bone = |name: &str| Bone {
+            name: name.into(),
+            ..Default::default()
+        };
+        let cond = |is: Option<&str>, not: Option<&str>| Play {
+            animation: 0,
+            property: "honey_level".into(),
+            is: is.map(Into::into),
+            not: not.map(Into::into),
+        };
+        let m = Model {
+            bones: vec![bone("Main"), bone("InnerBurning"), bone("InnerEmpty")],
+            show: vec![(1, cond(None, Some("0"))), (2, cond(Some("0"), None))],
+            ..Default::default()
+        };
+        let at =
+            |level: &'static str| move |k: &str| (k == "honey_level").then(|| level.to_owned());
+        assert_eq!(m.hidden_by(&at("0")), 0b010, "cold: InnerEmpty shows");
+        assert_eq!(m.hidden_by(&at("3")), 0b100, "burning: InnerBurning shows");
+        // A state without the property hides both.
+        assert_eq!(m.hidden_by(&|_: &str| None), 0b110);
+    }
+
+    #[test]
+    fn a_model_at_rest_holds_its_first_frame() {
+        let mut m = Model {
+            bones: vec![Bone::default()],
+            scale: 1.0,
+            ..Default::default()
+        };
+        assert_eq!(m.pose(None, 3.0), vec![Mat4::IDENTITY]);
+        m.animations.push(Animation {
+            name: "pump".into(),
+            length: 1.0,
+            looping: true,
+            channels: vec![(
+                0,
+                Channel {
+                    rotation: Vec::new(),
+                    position: vec![
+                        (0.0, Vec3::new(8.0, 0.0, 0.0)),
+                        (0.5, Vec3::new(-8.0, 0.0, 0.0)),
+                    ],
+                },
+            )],
+        });
+        // Half a block out, as sps(0) leaves HBM's pump.
+        let p = m.pose(None, 3.0)[0].transform_point3(Vec3::ZERO);
+        assert!((p - Vec3::new(0.5, 0.0, 0.0)).length() < 1e-4, "{p}");
+    }
+}
