+            .as_ref()
+            .map_or(Some(([8.0, 6.0], false)), |s| s.title)
+            .unwrap_or(([8.0, 6.0], false));
+        if screen.as_ref().is_none_or(|s| s.title.is_some()) {
+            let tw = atlas.font.width_text(&title);
+            let tx = if centred {
+                title_at[0] - tw / 2.0
+            } else {
+                title_at[0]
+            };
+            let colour = screen
+                .as_ref()
+                .and_then(|s| s.title_color)
+                .map_or(grey, |c| {
+                    let [_, r, g, b] = c.to_be_bytes();
+                    rgba(r, g, b, 255)
+                });
+            batch.text_styled(atlas, &title, ox + tx, oy + title_at[1], colour, false);
+        }
+        let label = screen.as_ref().map_or(
+            Some([def.inventory[0] as f32, def.inventory[1] as f32 - 12.0]),
+            |s| s.inventory_label,
+        );
+        if let Some([lx, ly]) = label {
+            let inventory = self.translate("container.inventory", "Inventory");
+            batch.text(atlas, &inventory, ox + lx, oy + ly, grey, false);
+        }
+    }
+
+    /// The tooltip of the bar or button under the pointer, when no slot's is shown.
+    pub(super) fn draw_mod_machine_tooltip(&mut self, batch: &mut HudBatch) {
+        if self.carried.is_some() || self.slot_at(batch, self.cursor.0, self.cursor.1).is_some() {
+            return;
+        }
+        let Some((_, Some(screen))) = self.open_machine() else {
+            return;
+        };
+        let Some(BlockEntity::ModContainer(m)) = self.container_kind() else {
+            return;
+        };
+        let (ox, oy) = self.inventory_origin(batch);
+        let Some(lines) = screen.tooltip(self.cursor.0 - ox, self.cursor.1 - oy, &m.data) else {
+            return;
+        };
+        let lines: Vec<_> = lines
+            .into_iter()
+            .map(|l| (horizon_client::text::Text::literal(l), u32::MAX))
+            .collect();
+        self.draw_tooltip_lines(batch, &lines, self.cursor.0, self.cursor.1);
+    }
+
+    /// A click on one of the open machine screen's buttons: the server's
+    /// mods hear it (`ServerboundContainerButtonClickPacket`). False when the
+    /// pointer is on no button.
+    pub(super) fn mod_machine_button_click(&mut self) -> bool {
+        let Some((_, Some(screen))) = self.open_machine() else {
+            return false;
+        };
+        let Some(size) = self
+            .renderer
+            .as_ref()
+            .map(|r| [r.config.width, r.config.height])
+        else {
+            return false;
+        };
+        let batch = HudBatch::new(size);
+        let (ox, oy) = self.inventory_origin(&batch);
+        let shift =
+            self.keys.contains(&KeyCode::ShiftLeft) || self.keys.contains(&KeyCode::ShiftRight);
+        let Some(button) = screen.button_at(self.cursor.0 - ox, self.cursor.1 - oy, shift) else {
+            return false;
+        };
+        self.audio
+            .play("minecraft:ui.button.click", None, 0.25, 1.0);
+        if let Some((window, _)) = self.remote.as_ref().and_then(|r| r.menu.clone()) {
+            self.send(
+                horizon_protocol::packets::play::Serverbound::ContainerButtonClick(
+                    horizon_protocol::packets::play::ContainerButtonClick {
+                        container: window,
+                        button: button as i32,
+                    },
+                ),
+            );
+        } else if let Some(key) = self.container {
+            let u = self.acting_player_uuid();
+            let uuid = u.iter().fold(0u128, |a, &w| a << 32 | u128::from(w as u32));
+            self.machine_button(uuid, [key.0, key.1, key.2], button);
+        }
+        true
+    }
+}
