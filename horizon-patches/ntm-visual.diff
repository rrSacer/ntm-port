+impl Game<'_> {
+    /// The facing of the block at `pos`, `north`...
+    fn facing_at(&self, pos: [i32; 3]) -> Option<String> {
+        let state = self.world.block(pos[0], pos[1], pos[2]);
+        self.pack
+            .assets
+            .registry
+            .state(state)
+            .and_then(|s| s.properties.get("facing").cloned())
+    }
+
+    /// A multiblock's cell outlines the whole volume, as HBM's
+    /// `BlockDummyable` boxes do: the box relative to the cell at `pos`.
+    pub(super) fn multiblock_outline(&self, pos: [i32; 3], name: &str) -> Option<[f64; 6]> {
+        if name.starts_with("minecraft:") {
+            return None;
+        }
+        let core = if horizon_world::mod_machines::is_dummy(name) {
+            horizon_world::mod_machines::core_of(pos, |c| {
+                let state = self.world.block(c[0], c[1], c[2]);
+                (
+                    self.res.facts().get(state).name.to_string(),
+                    self.facing_at(c),
+                )
+            })?
+        } else {
+            pos
+        };
+        let state = self.world.block(core[0], core[1], core[2]);
+        let def = horizon_world::mod_machines::get(&self.res.facts().get(state).name)?;
+        let m = def.multiblock.as_ref()?;
+        let facing = self
+            .facing_at(core)
+            .as_deref()
+            .and_then(horizon_world::mod_machines::facing_step)?;
+        let (lo, hi) = m.bounds(core, facing);
+        let rel = |v: i32, i: usize| f64::from(v - pos[i]);
+        Some([
+            rel(lo[0], 0),
+            rel(lo[1], 1),
+            rel(lo[2], 2),
+            rel(hi[0], 0),
+            rel(hi[1], 1),
+            rel(hi[2], 2),
+        ])
+    }
+}
+
+/// Which machine screen's texture is in each GUI slot of the atlas
+/// (`hud::GUI_SLOTS`), least recently opened first.
+static GUI_SLOT_USERS: std::sync::Mutex<Vec<(String, usize)>> = std::sync::Mutex::new(Vec::new());
+
+impl Game<'_> {
+    /// The open machine screen's texture into a GUI slot of the atlas, when
+    /// it is not there: the slot of the least recently opened screen.
+    pub(super) fn load_machine_screen_texture(&mut self) {
+        use horizon_client::hud::{GUI_SLOT_SIZE, GUI_SLOTS};
+        let Some((_, Some(screen))) = self.open_machine() else {
+            return;
+        };
+        let Ok(mut users) = GUI_SLOT_USERS.lock() else {
+            return;
+        };
+        if self.gui.atlas.sprites.contains_key(&screen.sprite) {
+            if let Some(i) = users.iter().position(|(n, _)| *n == screen.sprite) {
+                let used = users.remove(i);
+                users.push(used);
+            }
+            return;
+        }
+        users.retain(|(n, _)| *n != screen.sprite);
+        let (w, h, rgba) = match horizon_client::hud::decode(&screen.file) {
+            Ok(image) if image.0 <= GUI_SLOT_SIZE && image.1 <= GUI_SLOT_SIZE => image,
+            Ok((w, h, _)) => {
+                log::warn!(
+                    "Horizon: {} is {w}x{h}, more than a GUI slot's {GUI_SLOT_SIZE}",
+                    screen.file.display()
+                );
+                return;
+            }
+            Err(e) => {
+                log::warn!("Horizon: {}: {e}", screen.file.display());
+                return;
+            }
+        };
+        let free = (0..GUI_SLOTS).find(|s| users.iter().all(|(_, u)| u != s));
+        let slot = match free {
+            Some(s) => s,
+            None => {
+                let (old, s) = users.remove(0);
+                self.gui.atlas.sprites.remove(&old);
+                s
+            }
+        };
+        let Some(base) = self
+            .gui
+            .atlas
+            .sprites
+            .get(&format!("horizon/gui{slot}"))
+            .copied()
+        else {
+            return;
+        };
+        let (aw, ah) = (self.gui.atlas.width as f32, self.gui.atlas.height as f32);
+        self.map_patches.push(horizon_client::font::Patch {
+            x: (base.u0 * aw).round() as u32,
+            y: (base.v0 * ah).round() as u32,
+            width: w,
+            height: h,
+            rgba,
+        });
+        let rect = horizon_client::hud::Rect {
+            u1: base.u0 + w as f32 / aw,
+            v1: base.v0 + h as f32 / ah,
+            w,
+            h,
+            ..base
+        };
+        self.gui.atlas.sprites.insert(screen.sprite.clone(), rect);
+        users.push((screen.sprite.clone(), slot));
+    }
+}
