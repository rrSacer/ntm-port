new file mode 100644
index 000000000..12dcb4f13
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/mod_models.rs
@@ -0,0 +1,144 @@
+//! Content mods' block models (`crate::mod_models`) drawn from meshes kept on
+//! the GPU: each bone of each model is uploaded once, in its own frame, and a
+//! frame sends one matrix and light per bone of each block it draws (as the
+//! lightning renderer keeps its bolts and sends their offsets). Moving bones
+//! cost the CPU a matrix, not their vertices.
+use crate::{gfx::upload::Uploads, mesher::Vertex};
+use std::{collections::HashMap, ops::Range};
+use wgpu::util::DeviceExt;
+
+/// Which mesh: a model and one of its bones.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct Key {
+    pub model: u32,
+    pub bone: u32,
+}
+
+/// One bone of one block: the matrix from the bone's frame to the
+/// camera-relative world (column major), and the block's packed light.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct Instance {
+    pub matrix: [f32; 16],
+    pub light: u32,
+}
+
+#[derive(Default)]
+pub struct Input<'a> {
+    /// The bones to draw, in any order.
+    pub draws: &'a [(Key, Instance)],
+    /// The vertices of a bone not uploaded yet (UVs on the atlas).
+    pub mesh: Option<&'a dyn Fn(Key) -> Vec<Vertex>>,
+    /// Changes when the meshes do (a new atlas, models reloaded): the
+    /// uploaded ones are dropped.
+    pub epoch: u64,
+}
+
+struct Mesh {
+    buffer: Option<wgpu::Buffer>,
+    quads: u32,
+}
+
+pub(super) struct Renderer {
+    meshes: HashMap<Key, Mesh>,
+    epoch: u64,
+    instances: Option<wgpu::Buffer>,
+    capacity: usize,
+    groups: Vec<(Key, Range<u32>)>,
+}
+
+impl Renderer {
+    pub(super) fn new() -> Self {
+        Self {
+            meshes: HashMap::new(),
+            epoch: 0,
+            instances: None,
+            capacity: 0,
+            groups: Vec::new(),
+        }
+    }
+
+    /// The most quads one bone draws: the shared quad indices must reach it.
+    pub(super) fn max_quads(&self) -> u32 {
+        self.groups
+            .iter()
+            .filter_map(|(k, _)| self.meshes.get(k))
+            .map(|m| m.quads)
+            .max()
+            .unwrap_or(0)
+    }
+
+    pub(super) fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        uploads: &mut Uploads,
+        encoder: &mut wgpu::CommandEncoder,
+        input: &Input<'_>,
+    ) {
+        self.groups.clear();
+        if input.epoch != self.epoch {
+            self.meshes.clear();
+            self.epoch = input.epoch;
+        }
+        if input.draws.is_empty() {
+            // Nothing drawn: the instances go, the meshes stay for the next ones.
+            self.instances = None;
+            self.capacity = 0;
+            return;
+        }
+        let mut order: Vec<usize> = (0..input.draws.len()).collect();
+        order.sort_by_key(|&i| input.draws[i].0);
+        let mut instances = Vec::with_capacity(order.len());
+        for &i in &order {
+            let (key, instance) = input.draws[i];
+            self.meshes.entry(key).or_insert_with(|| {
+                let vertices = input.mesh.map(|m| m(key)).unwrap_or_default();
+                let quads = (vertices.len() / 4) as u32;
+                let buffer = (quads > 0).then(|| {
+                    device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                        label: Some("Mod model bone"),
+                        contents: bytemuck::cast_slice(&vertices),
+                        usage: wgpu::BufferUsages::VERTEX,
+                    })
+                });
+                Mesh { buffer, quads }
+            });
+            let n = instances.len() as u32;
+            match self.groups.last_mut() {
+                Some((k, range)) if *k == key => range.end = n + 1,
+                _ => self.groups.push((key, n..n + 1)),
+            }
+            instances.push(instance);
+        }
+        if instances.len() > self.capacity || instances.len() < self.capacity / 4 {
+            self.capacity = instances.len().next_power_of_two();
+            self.instances = Some(device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("Mod model instances"),
+                size: (self.capacity * std::mem::size_of::<Instance>()) as u64,
+                usage: wgpu::BufferUsages::VERTEX | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            }));
+        }
+        if let Some(buffer) = &self.instances {
+            uploads.buffer(encoder, buffer, 0, bytemuck::cast_slice(&instances));
+        }
+    }
+
+    pub(super) fn draw(&self, pass: &mut wgpu::RenderPass<'_>) {
+        let Some(instances) = &self.instances else {
+            return;
+        };
+        pass.set_vertex_buffer(1, instances.slice(..));
+        for (key, range) in &self.groups {
+            let Some(Mesh {
+                buffer: Some(buffer),
+                quads,
+            }) = self.meshes.get(key)
+            else {
+                continue;
+            };
+            pass.set_vertex_buffer(0, buffer.slice(..));
+            pass.draw_indexed(0..quads * 6, 0, range.clone());
+        }
+    }
+}
