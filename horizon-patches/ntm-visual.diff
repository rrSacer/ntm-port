+                    batch.fill(atlas, ox + x, oy + y, 16.0, 16.0, rgba(139, 139, 139, 255));
+                }
+            }
+        }
+        let title = self.remote_menu_title().unwrap_or_else(|| {
+            let key = def.title.clone().unwrap_or_else(|| {
+                let (ns, path) = def
+                    .block
+                    .split_once(':')
+                    .unwrap_or(("minecraft", &def.block));
+                format!("block.{ns}.{path}")
+            });
+            horizon_client::text::Text::literal(self.translate(&key, &def.block))
+        });
